# ============================================================
# 部署到 Vercel 时，把这些变量填到 Vercel 的 Environment Variables
# 本地开发用 .env（已被 .gitignore 忽略，不会上传）
# ============================================================

# 数据库连接。本地是 SQLite；部署时必须换成托管 PostgreSQL 的连接串，
# 例如 Neon / Supabase 免费库：
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public&sslmode=require"

# 会话 JWT 签名密钥。本地已生成一份，部署时可直接复用 .env 里的值，
# 或重新生成：  openssl rand -base64 32
SESSION_SECRET=""

# Web Push (VAPID) 密钥对。本地已生成，部署时把 .env 里的对应值原样填过来即可。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# 定时任务手动触发密钥。GET /api/cron?secret=xxx 校验用。留空则免校验。
CRON_SECRET=""

# 站点公网地址。部署后填 Vercel 给的 https://xxx.vercel.app
NEXT_PUBLIC_SITE_URL=""
