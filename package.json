{
  "name": "dazi-platform",
  "version": "1.0.0",
  "private": true,
  "description": "大连理工盘锦校区「搭子」平台 - 移动端 PWA",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "https-proxy-agent": "^7.0.6",
    "jose": "5.9.6",
    "next": "^15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.2",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
